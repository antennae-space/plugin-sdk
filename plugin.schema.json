{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/antennae-space/plugin-sdk/blob/main/plugin.schema.json",
  "title": "plugin.json of an external plugin of Web IDE (apiVersion 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "ide",
    "assets",
    "contributes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Its id: the prefix of its methods (<id>.*), events and commands."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Its name, shown in Settings \u2192 Plugins."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Its version; the tag of a release is v<version>."
    },
    "apiVersion": {
      "const": 1
    },
    "ide": {
      "type": "string",
      "description": "A semver constraint on the version of the IDE (^1.24, >=1.23.0 <2)."
    },
    "plugins": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "The plugins it needs: id \u2192 semver constraint."
    },
    "assets": {
      "type": "string",
      "pattern": "^https://.*\\{version\\}.*\\{arch\\}",
      "description": "The address of its release archive, with {version} and {arch} (linux-amd64, linux-arm64)."
    },
    "backend": {
      "type": "string",
      "pattern": "^bin/[A-Za-z0-9._-]+$",
      "description": "The executable of its confined backend in the archive."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "description": "The grants it asks; the user accepts them one by one.",
      "items": {
        "anyOf": [
          {
            "enum": [
              "files:read",
              "files:write",
              "net",
              "exec",
              "dial",
              "ssh",
              "vault",
              "socket:docker",
              "terminal",
              "notify",
              "git",
              "gh",
              "worktrees"
            ]
          },
          {
            "type": "string",
            "pattern": "^core:[a-z][A-Za-z0-9_.]*$",
            "description": "A method of the core it may call (core:fs.list)."
          },
          {
            "type": "string",
            "pattern": "^program:[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "description": "A program its language servers run (program:gopls)."
          },
          {
            "type": "string",
            "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "description": "A program run on the host of an SSH project (exec:sqlite3), through backend.Exec; not confined there."
          },
          {
            "type": "string",
            "pattern": "^path:[A-Z][A-Z0-9_]*$",
            "description": "A folder of the host its language servers need (path:GOMODCACHE)."
          }
        ]
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capabilities it serves to the other external plugins (ide.register services, ide.publish, ide.emit; its backend's methods for service.call)."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capabilities it needs (terminal, worktrees, git\u2026); one an external plugin provides is used with ide.use and service.call."
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "icon",
              "zone"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string"
              },
              "zone": {
                "enum": [
                  "left",
                  "bottomLeft",
                  "bottomRight",
                  "right"
                ]
              },
              "before": {
                "type": "string",
                "description": "The tool it comes before in its zone."
              }
            }
          }
        },
        "modals": {
          "type": "array",
          "description": "Views opened in a modal of the IDE (ide.openModal), centered, titled with the plugin.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "type": "string", "description": "The title by default (a text of its catalog)." }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "Parameters of a project's address opening one of its tab views: /project/<id>?<param>=<value>, the value the key of the tab and the field param of its state.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["param", "view"],
            "properties": {
              "param": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": { "enum": ["open", "questions", "assistant", "chat", "desk"] } },
              "view": { "type": "string", "description": "One of its tab views." },
              "type": { "enum": ["number", "string"], "description": "The type of the value in the state (string by default)." }
            }
          }
        },
        "tabViews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "editor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lang"
                ],
                "description": "The IDE's editor above the view, driven by ide.editor.",
                "properties": {
                  "lang": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Its grammar: sql, redis, json, yaml, markdown, shell\u2026"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 90,
                    "description": "Its share of the tab's height, in percent (40)."
                  },
                  "keys": {
                    "type": "object",
                    "description": "Keys given to the view by name while the editor has the focus: {\"Ctrl+Enter\": \"run\"}.",
                    "propertyNames": {
                      "pattern": "^(Ctrl\\+)?(Alt\\+)?(Shift\\+)?(Meta\\+)?[A-Z][A-Za-z0-9]*$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  }
                }
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Default shortcuts, physical keys (Ctrl+Enter, Alt+KeyD)."
              },
              "replaces": {
                "type": "string"
              },
              "inTerminal": {
                "type": "boolean"
              }
            }
          }
        },
        "assistantTools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_0-9]*$"
          },
          "description": "Its tools for the assistant and the MCP, each described in toolSchemas."
        },
        "mcpTools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_0-9]*$"
          },
          "description": "Its tools for the MCP only (Claude Code, the agents), each described in toolSchemas; its backend gets the scope of the call (backend.Plugin.MCP)."
        },
        "questions": {
          "type": "boolean",
          "description": "Its backend asks the user through the Questions tool (backend.Plugin.Questions)."
        },
        "hooks": {
          "type": "array",
          "items": { "enum": ["project.open"] },
          "description": "The moments of a project its backend is told of: project.open, a window opened the project."
        },
        "toolSchemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "properties"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "properties": {
                "type": "object"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties"
          ],
          "properties": {
            "properties": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z_0-9]*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "title"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "enum": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "default": {}
                }
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "description": "Each one the method <id>.<action> of the backend and the assistant tool <id>_<action>.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "access"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "properties": {
                "type": "object"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "access": {
                "enum": [
                  "read",
                  "write"
                ],
                "description": "write: the user decides per target whether the AI may run it."
              },
              "target": {
                "type": "string",
                "description": "The argument naming what it acts on (a connection)."
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "description": "Makes the plugin a language pack: what it gives the language host.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "extensions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "name": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\.[A-Za-z0-9_+-]+$"
                }
              },
              "markers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "languageIds": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "grammar": {
                "type": "string",
                "pattern": "^grammars/[^/]+\\.json$"
              },
              "servers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "argv"
                  ],
                  "properties": {
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Its program (a bare name, on the PATH of the host, granted as program:<name>) and arguments."
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "candidates"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "candidates": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "$VAR/rest, ~/rest, @program/rest or an absolute path: the first that exists."
                          },
                          "access": {
                            "enum": [
                              "read",
                              "write"
                            ]
                          },
                          "env": {
                            "type": "boolean",
                            "description": "Pass it as the variable of its name."
                          }
                        }
                      }
                    },
                    "install": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["manager", "packages"],
                      "description": "How the IDE installs it when missing, into the pack's folder of tools (~/.local/share/web-ide/tools/<pack>): the IDE builds the command.",
                      "properties": {
                        "manager": { "enum": ["npm", "pip", "go"] },
                        "packages": {
                          "type": "array",
                          "items": { "type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/+=<>~^,\\[\\]-]*$" },
                          "description": "npm or pip packages (typescript@5, python-lsp-server[all]), or one Go module@version."
                        }
                      }
                    },
                    "pathDirs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Folders added to its PATH: <NAME>/rest."
                    },
                    "env": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[A-Z][A-Z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Literal variables of its environment."
                    }
                  }
                }
              },
              "tests": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
