{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@antennae-space/plugin-sdk/solid": [
        "./src/solid.tsx"
      ],
      "@antennae-space/plugin-sdk/ui": [
        "./src/ui/index.ts"
      ],
      "@antennae-space/plugin-sdk": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.d.ts",
    "example"
  ]
}
